<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_user_rule_tree" model="ir.ui.view">
        <field name="name">access.user.rule.tree</field>
        <field name="model">access.user.rule</field>
        <field name="arch" type="xml">
            <list string="User Rules" editable="bottom">
                <field name="user_id"/>
                <field name="model_id"/>
                <field name="perm_read"/>
                <field name="perm_write"/>
                <field name="perm_create"/>
                <field name="perm_unlink"/>
                <field name="note"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_access_user_rule_form" model="ir.ui.view">
        <field name="name">access.user.rule.form</field>
        <field name="model">access.user.rule</field>
        <field name="arch" type="xml">
            <form string="User Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="model_id"/>
                            <field name="active"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="perm_read"/>
                            <field name="perm_write"/>
                            <field name="perm_create"/>
                            <field name="perm_unlink" string="Delete"/>
                        </group>
                    </group>
                    <group string="Advanced">
                        <field name="perm_approve"/>
                        <field name="perm_export"/>
                        <field name="perm_import"/>
                        <field name="perm_print"/>
                        <field name="perm_duplicate"/>
                        <field name="perm_archive"/>
                        <field name="perm_share"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_access_user_rule_search" model="ir.ui.view">
        <field name="name">access.user.rule.search</field>
        <field name="model">access.user.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_id"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_access_user_rule" model="ir.actions.act_window">
        <field name="name">User Permissions</field>
        <field name="res_model">access.user.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_access_user_rule_search"/>
    </record>
</odoo>
