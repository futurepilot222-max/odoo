<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_field_rule_tree" model="ir.ui.view">
        <field name="name">access.field.rule.tree</field>
        <field name="model">access.field.rule</field>
        <field name="arch" type="xml">
            <list string="Field Rules" editable="bottom">
                <field name="role_id"/>
                <field name="model_id"/>
                <field name="field_id" domain="[('model_id', '=', model_id)]"/>
                <field name="readonly"/>
                <field name="invisible"/>
            </list>
        </field>
    </record>

    <record id="view_access_field_rule_search" model="ir.ui.view">
        <field name="name">access.field.rule.search</field>
        <field name="model">access.field.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="role_id"/>
                <field name="model_id"/>
                <field name="field_id"/>
                <filter string="Read-only" name="filter_ro" domain="[('readonly', '=', True)]"/>
                <filter string="Hidden" name="filter_invisible" domain="[('invisible', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Role" name="group_role" context="{'group_by': 'role_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_access_field_rule" model="ir.actions.act_window">
        <field name="name">Field Permissions</field>
        <field name="res_model">access.field.rule</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_access_field_rule_search"/>
    </record>
</odoo>
