<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="role_viewer" model="access.role">
        <field name="name">Viewer</field>
        <field name="code">viewer</field>
        <field name="sequence">10</field>
        <field name="description">Can open records and see all data. Cannot create, edit, delete or approve.</field>
        <field name="state">active</field>
    </record>

    <record id="role_editor" model="access.role">
        <field name="name">Editor</field>
        <field name="code">editor</field>
        <field name="sequence">20</field>
        <field name="description">Can create and edit records but cannot delete or approve.</field>
        <field name="state">active</field>
    </record>

    <record id="role_manager" model="access.role">
        <field name="name">Manager</field>
        <field name="code">manager</field>
        <field name="sequence">30</field>
        <field name="description">Full CRUD plus approve, print and export. Can see team records.</field>
        <field name="state">active</field>
    </record>

    <record id="role_supervisor" model="access.role">
        <field name="name">Supervisor</field>
        <field name="code">supervisor</field>
        <field name="sequence">40</field>
        <field name="description">Read, edit and approve. No delete.</field>
        <field name="state">active</field>
    </record>

    <record id="role_accountant" model="access.role">
        <field name="name">Accountant</field>
        <field name="code">accountant</field>
        <field name="sequence">50</field>
        <field name="description">Bookkeeping access to financial models.</field>
        <field name="state">active</field>
    </record>

    <record id="role_sales_user" model="access.role">
        <field name="name">Sales User</field>
        <field name="code">sales_user</field>
        <field name="sequence">60</field>
        <field name="description">Sales executive: own quotations create / edit only.</field>
        <field name="state">active</field>
    </record>

    <record id="role_sales_manager" model="access.role">
        <field name="name">Sales Manager</field>
        <field name="code">sales_manager</field>
        <field name="sequence">70</field>
        <field name="description">Sales manager: team-wide visibility plus approve / export / print.</field>
        <field name="state">active</field>
    </record>
</odoo>
