<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_menu_rule_tree" model="ir.ui.view">
        <field name="name">access.menu.rule.tree</field>
        <field name="model">access.menu.rule</field>
        <field name="arch" type="xml">
            <list string="Menu Rules" editable="bottom">
                <field name="role_id"/>
                <field name="menu_id"/>
                <field name="visible"/>
            </list>
        </field>
    </record>

    <record id="view_access_menu_rule_search" model="ir.ui.view">
        <field name="name">access.menu.rule.search</field>
        <field name="model">access.menu.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="role_id"/>
                <field name="menu_id"/>
                <group expand="0" string="Group By">
                    <filter string="Role" name="group_role" context="{'group_by': 'role_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_access_menu_rule" model="ir.actions.act_window">
        <field name="name">Menu Permissions</field>
        <field name="res_model">access.menu.rule</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_access_menu_rule_search"/>
    </record>
</odoo>
