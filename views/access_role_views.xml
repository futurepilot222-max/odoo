<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permission matrix line tree (editable in role form) -->
    <record id="view_access_role_line_tree" model="ir.ui.view">
        <field name="name">access.role.line.tree</field>
        <field name="model">access.role.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Model Permissions">
                <field name="model_id" options="{'no_create': True}"/>
                <field name="model_name" optional="hide"/>
                <field name="perm_read"/>
                <field name="perm_write"/>
                <field name="perm_create"/>
                <field name="perm_unlink" string="Delete"/>
                <field name="perm_approve"/>
                <field name="perm_export"/>
                <field name="perm_import"/>
                <field name="perm_print"/>
                <field name="perm_duplicate" optional="hide"/>
                <field name="perm_archive" optional="hide"/>
                <field name="perm_share" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Role form -->
    <record id="view_access_role_form" model="ir.ui.view">
        <field name="name">access.role.form</field>
        <field name="model">access.role</field>
        <field name="arch" type="xml">
            <form string="Access Role">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_resync" string="Re-sync Security" type="object"
                            class="btn-secondary"/>
                    <button name="action_archive_role" string="Archive" type="object"
                            invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_users" icon="fa-users">
                            <field name="user_count" widget="statinfo" string="Users"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Manager"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. sales_manager"/>
                            <field name="category_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="group_id" readonly="1"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe what this role can and cannot do..."/>
                    <notebook>
                        <page string="Model Permissions" name="lines">
                            <group>
                                <field name="crud_strict_mode"/>
                            </group>
                            <div class="text-muted" style="margin-bottom:8px;">
                                When <b>Strict CRUD Mode</b> is enabled, the CRUD ticks below become the <b>ceiling</b> for users assigned this role.
                                Operations not ticked (Write / Create / Delete) are denied on these models even if the user belongs to other groups that would normally grant them.
                                Models not listed below are unaffected.
                            </div>
                            <field name="line_ids"/>
                            <div class="text-muted" style="margin-top:8px;">
                                Read / Write / Create / Delete are enforced by the native ir.model.access engine (additive) and, when Strict CRUD Mode is on, also as a ceiling.
                                Approve / Export / Import / Print / Duplicate / Archive / Share are exposed through the role's security group for views and buttons.
                            </div>
                        </page>
                        <page string="Menu Visibility" name="menus">
                            <group>
                                <field name="menu_strict_mode"/>
                            </group>
                            <div class="text-muted" style="margin-bottom:8px;">
                                When <b>Strict Menu Mode</b> is enabled, users assigned this role will see <b>only</b> the menus ticked Visible below (plus their parents).
                                Other menus they could otherwise see via different groups will be hidden.
                                When disabled, ticking Visible only <i>adds</i> the menu for this role's group (additive Odoo behaviour).
                            </div>
                            <field name="menu_rule_ids" context="{'default_role_id': id}">
                                <list editable="bottom">
                                    <field name="menu_id"/>
                                    <field name="visible"/>
                                </list>
                            </field>
                        </page>
                        <page string="Field Restrictions" name="fields">
                            <field name="field_rule_ids" context="{'default_role_id': id}">
                                <list editable="bottom">
                                    <field name="model_id"/>
                                    <field name="field_id" domain="[('model_id', '=', model_id)]"/>
                                    <field name="readonly"/>
                                    <field name="invisible"/>
                                </list>
                            </field>
                        </page>
                        <page string="Button Rules" name="buttons">
                            <div class="text-muted" style="margin-bottom:8px;">
                                Hide form-view buttons (Confirm / Cancel / Reset to Draft / Send / custom workflow buttons) for users assigned this role.
                                The <b>Button Name</b> is the technical name of the button - usually the method invoked, e.g. <code>action_confirm</code>, <code>action_cancel</code>, <code>action_draft</code>.
                                The <b>Label</b> is just for your reference.
                                Hiding semantics: if any role assigned to the user marks a button as hidden, it is hidden.
                            </div>
                            <field name="button_rule_ids" context="{'default_role_id': id}">
                                <list editable="bottom">
                                    <field name="model_id"/>
                                    <field name="button_name"/>
                                    <field name="label"/>
                                    <field name="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Record Rules" name="records">
                            <field name="record_rule_ids" context="{'default_role_id': id}">
                                <list editable="bottom">
                                    <field name="model_id"/>
                                    <field name="rule_type"/>
                                    <field name="custom_domain" required="rule_type == 'custom'" invisible="rule_type != 'custom'"/>
                                    <field name="perm_read"/>
                                    <field name="perm_write"/>
                                    <field name="perm_create"/>
                                    <field name="perm_unlink"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Role tree -->
    <record id="view_access_role_tree" model="ir.ui.view">
        <field name="name">access.role.tree</field>
        <field name="model">access.role</field>
        <field name="arch" type="xml">
            <list string="Access Roles" decoration-muted="state == 'archived'" decoration-info="state == 'draft'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="user_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Role search -->
    <record id="view_access_role_search" model="ir.ui.view">
        <field name="name">access.role.search</field>
        <field name="model">access.role</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="user_ids"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Archived" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_access_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">access.role</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_access_role_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first access role</p>
            <p>Roles bundle model permissions, menu visibility, field restrictions and record rules. Assign roles to users instead of giving them individual groups.</p>
        </field>
    </record>
</odoo>
