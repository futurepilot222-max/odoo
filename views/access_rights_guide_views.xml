<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_rights_guide_form" model="ir.ui.view">
        <field name="name">access.rights.guide.form</field>
        <field name="model">access.rights.guide</field>
        <field name="arch" type="xml">
            <form string="User Guide" create="false" edit="false">
                <sheet>
                    <field name="content" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_access_rights_guide" model="ir.actions.act_window">
        <field name="name">User Guide</field>
        <field name="res_model">access.rights.guide</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_access_rights_guide_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_access_user_guide"
              name="User Guide"
              parent="menu_access_root"
              action="action_access_rights_guide"
              sequence="90"/>
</odoo>
