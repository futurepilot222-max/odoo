<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="module_category_access_management" model="ir.module.category">
        <field name="name">Global Access Management</field>
        <field name="description">Manage roles, user permissions, menu/field/record access and audit logs.</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_access_user" model="res.groups">
        <field name="name">Access: Viewer</field>
        <field name="category_id" ref="module_category_access_management"/>
        <field name="comment">Can read roles, rules and the audit log but cannot modify them.</field>
    </record>

    <record id="group_access_manager" model="res.groups">
        <field name="name">Access: Administrator</field>
        <field name="category_id" ref="module_category_access_management"/>
        <field name="implied_ids" eval="[(4, ref('group_access_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
        <field name="comment">Full control over roles, user rules, menu/field/record rules.</field>
    </record>

    <!-- Make every Settings administrator (base.group_system) automatically a
         member of Access: Administrator, so anyone who can install/manage
         Odoo can also use this module out of the box. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_access_manager'))]"/>
    </record>
</odoo>
